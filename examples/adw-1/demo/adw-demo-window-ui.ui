<?xml version="1.0" encoding="UTF-8"?>
<interface><requires version="4.0" lib="gtk" /><requires version="1.0" lib="libadwaita" /><menu id="primary-menu"><section><item><attribute name="label" translatable="yes">_Inspector</attribute><attribute name="action">app.inspector</attribute></item><item><attribute name="label" translatable="yes">A_daptive Preview</attribute><attribute name="action">window.adaptive-preview</attribute></item></section><section><item><attribute name="label" translatable="yes">_Preferences</attribute><attribute name="action">app.preferences</attribute></item><item><attribute name="label" translatable="yes">_About Adwaita Demo</attribute><attribute name="action">app.about</attribute></item></section></menu><template class="AdwDemoWindow" parent="AdwApplicationWindow"><property name="title" translatable="yes">Adwaita Demo</property><property name="default-width">800</property><property name="default-height">576</property><child><object class="AdwBreakpoint"><condition>max-width: 500sp</condition><setter object="split-view" property="collapsed">True</setter></object></child><property name="content"><object class="AdwToastOverlay" id="toast-overlay"><property name="child"><object class="AdwNavigationSplitView" id="split-view"><property name="min-sidebar-width">200</property><property name="sidebar"><object class="AdwNavigationPage"><property name="title" bind-source="AdwDemoWindow" bind-property="title" bind-flags="sync-create" /><property name="child"><object class="AdwToolbarView"><child type="top"><object class="AdwHeaderBar"><child type="start"><object class="GtkButton" id="color-scheme-button" /></child><child type="end"><object class="GtkMenuButton"><property name="tooltip-text" translatable="yes">Main Menu</property><property name="menu-model">primary-menu</property><property name="icon-name">open-menu-symbolic</property><property name="primary">True</property></object></child></object></child><property name="content"><object class="GtkStackSidebar"><property name="stack">stack</property></object></property></object></property></object></property><property name="content"><object class="AdwNavigationPage" id="content"><property name="title">Hidden but ...</property><property name="child"><object class="GtkStack" id="stack"><property name="vhomogeneous">False</property><child><object class="GtkStackPage"><property name="title" translatable="yes">Welcome</property><property name="child"><object class="AdwDemoPageWelcome" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Navigation View</property><property name="child"><object class="AdwDemoPageNavigationView" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Clamp</property><property name="child"><object class="AdwDemoPageClamp" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Lists</property><property name="child"><object class="AdwDemoPageLists" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">View Switcher</property><property name="child"><object class="AdwDemoPageViewSwitcher" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Carousel</property><property name="child"><object class="AdwDemoPageCarousel" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Avatar</property><property name="child"><object class="AdwDemoPageAvatar" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Split Views</property><property name="child"><object class="AdwDemoPageSplitViews" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Tab View</property><property name="child"><object class="AdwDemoPageTabView" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Buttons</property><property name="child"><object class="AdwDemoPageButtons" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Style Classes</property><property name="child"><object class="AdwDemoPageStyleClasses" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Toasts</property><property name="child"><object class="AdwDemoPageToasts" id="toasts-page" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Animations</property><property name="child"><object class="AdwDemoPageAnimations" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Alert Dialog</property><property name="child"><object class="AdwDemoPageAlerts" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">About Dialog</property><property name="child"><object class="AdwDemoPageAbout" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Banner</property><property name="child"><object class="AdwDemoPageBanner" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Bottom Sheet</property><property name="child"><object class="AdwDemoPageBottomSheets" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Multi-Layout View</property><property name="child"><object class="AdwDemoPageMultiLayout" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Spinner</property><property name="child"><object class="AdwDemoPageSpinner" /></property></object></child><child><object class="GtkStackPage"><property name="title" translatable="yes">Toggle Groups</property><property name="child"